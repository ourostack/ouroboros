{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@ouro.bot/friends/a2a-client": ["./node_modules/@ouro.bot/friends/dist/a2a-client/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
