        "ManagedCodexTurnLedgerTests.test_failed_interrupted_or_error_bearing_root_is_never_success",
        "ManagedCodexTurnLedgerTests.test_root_done_does_not_close_unknown_or_later_autonomous_work",
        "ManagedCodexTurnLedgerTests.test_partial_ingress_immediately_revokes_work_evidence_and_native_revision",
        "ManagedCodexTurnLedgerTests.test_second_input_requires_complete_prior_evidence_and_cannot_reuse_turn_ids",
        "ManagedCodexTurnLedgerTests.test_exact_foreground_callback_requires_native_work_and_consumed_result",
        "ManagedCodexTurnLedgerTests.test_callback_write_is_not_consumption_and_exact_early_consumption_waits_for_full_write",
        "ManagedCodexTurnLedgerTests.test_wrong_call_arguments_content_success_or_foreign_callback_cannot_discharge_work",
        "ManagedCodexTurnLedgerTests.test_a_known_complete_failed_command_is_consumed_but_not_confused_with_unknown_work",
        "ManagedCodexTurnLedgerTests.test_unmatched_or_disabled_tool_requests_are_held_before_native_dispatch",
        "ManagedCodexTurnLedgerTests.test_partial_shell_pages_or_empty_reply_without_write_never_establish_coverage",
        "ManagedCodexTurnLedgerTests.test_background_shell_or_activity_during_inspection_is_not_a_clean_snapshot",
        "ManagedCodexTurnLedgerTests.test_passive_message_lifecycles_are_bound_and_do_not_replace_root_completion",
