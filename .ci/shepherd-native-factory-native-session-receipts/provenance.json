        "ManagedCodexTurnLedgerTests.test_malformed_passive_metadata_cannot_still_produce_positive_work_evidence",
        "ManagedCodexTurnLedgerTests.test_valid_final_answer_phase_and_citations_remain_passive_not_root_completion",
        "ManagedCodexTurnLedgerTests.test_backend_fallback_cannot_impersonate_consumption_of_an_identical_failed_command",
        "ManagedCodexTurnLedgerTests.test_callback_result_witness_is_unique_and_cannot_be_replayed_between_identical_commands",
        "ManagedCodexTurnLedgerTests.test_pinned_reasoning_progress_is_passive_and_bound_to_its_live_root_item",
        "ManagedCodexTurnLedgerTests.test_reasoning_progress_rejects_foreign_closed_or_malformed_indices",
        "ManagedCodexTurnLedgerTests.test_known_queued_callbacks_do_not_overlap_the_kept_native_command_service",
        "ManagedCodexTurnLedgerTests.test_owner_prompt_limit_counts_exact_utf8_bytes_without_clipping_or_rewriting",
