  "suites": {
    "scripts/tests/test_managed_codex_startup.py": {
      "names": [
        "ManagedCodexStartupTests.test_exact_descriptor_initializes_only_the_bound_birth_and_real_thread",
        "ManagedCodexStartupTests.test_early_ready_waits_for_the_actual_initialize_write_witness",
        "ManagedCodexStartupTests.test_source_catalog_schema_and_profile_changes_never_initialize",
        "ManagedCodexStartupTests.test_every_effective_policy_field_is_checked_before_initialization",
        "ManagedCodexStartupTests.test_every_closed_feature_and_missing_or_extra_policy_value_refuses",
        "ManagedCodexStartupTests.test_nonce_cwd_store_and_envelope_drift_cannot_bind",
        "ManagedCodexStartupTests.test_boolean_number_and_nested_policy_coercions_refuse",
        "ManagedCodexStartupTests.test_duplicate_keys_invalid_utf8_and_truncated_descriptors_hold",
        "ManagedCodexStartupTests.test_coalesced_duplicate_descriptor_or_preinitialize_work_writes_nothing",
        "ManagedCodexStartupTests.test_refused_initialize_write_cannot_create_readiness",
        "ManagedCodexStartupTests.test_ready_identity_or_policy_drift_and_foreign_ack_hold",
        "ManagedCodexStartupTests.test_fragmented_bytes_preserve_the_same_exact_descriptor_binding"
      ],
      "failures": {}
    },
    "scripts/tests/test_managed_codex_stream.py": {
      "names": [
        "ManagedCodexStreamTests.test_exact_request_notification_response_and_error_envelopes_stay_distinct",
        "ManagedCodexStreamTests.test_raw_fields_and_multibyte_text_survive_every_pipe_boundary",
        "ManagedCodexStreamTests.test_string_and_integer_request_ids_never_alias_or_lose_64_bit_precision",
        "ManagedCodexStreamTests.test_incomplete_json_at_real_eof_cannot_be_forced_out_or_resumed",
        "ManagedCodexStreamTests.test_invalid_utf8_latches_instead_of_decoding_replacement_text",
        "ManagedCodexStreamTests.test_byte_limit_is_inclusive_and_overflow_never_recovers",
        "ManagedCodexStreamTests.test_finish_is_idempotent_but_any_append_after_eof_is_closed",
        "ManagedCodexStreamTests.test_malformed_or_ambiguous_envelopes_are_terminal_not_best_effort",
        "ManagedCodexStreamTests.test_invalid_request_id_types_do_not_become_notifications_or_integer_aliases",
        "ManagedCodexStreamTests.test_invalid_json_and_nonobjects_cannot_be_silently_skipped",
        "ManagedCodexStreamTests.test_a_valid_message_with_a_partial_next_frame_is_never_a_drained_stream",
        "ManagedCodexStreamTests.test_duplicate_json_members_at_any_depth_cannot_change_wire_identity",
        "ManagedCodexStreamTests.test_keys_in_distinct_objects_and_json_looking_literal_strings_are_not_duplicates",
        "ManagedCodexStreamTests.test_wire_size_preserves_actual_utf8_whitespace_and_crlf_not_reserialized_size"
      ],
      "failures": {}
    },
    "scripts/tests/test_managed_codex_shell_inventory.py": {
      "names": [
        "ManagedCodexShellInventoryTests.test_empty_page_is_not_positive_until_exact_full_request_write_and_response",
        "ManagedCodexShellInventoryTests.test_written_request_is_not_a_readback_and_no_page_is_not_an_empty_inventory",
        "ManagedCodexShellInventoryTests.test_every_cursor_is_visited_before_a_multi_page_empty_inventory_completes",
        "ManagedCodexShellInventoryTests.test_nonempty_inventory_is_complete_but_never_reports_empty_work",
        "ManagedCodexShellInventoryTests.test_foreign_error_request_notification_and_duplicate_responses_are_not_pages",
        "ManagedCodexShellInventoryTests.test_revision_change_before_request_write_reply_or_next_page_is_terminal",
        "ManagedCodexShellInventoryTests.test_cursor_cycles_empty_malformed_and_oversized_cursors_are_terminal",
        "ManagedCodexShellInventoryTests.test_missing_null_partial_or_unknown_page_shapes_are_not_empty",
        "ManagedCodexShellInventoryTests.test_duplicate_item_or_process_identity_in_one_or_later_pages_is_terminal",
        "ManagedCodexShellInventoryTests.test_partial_malformed_terminal_records_cannot_be_dropped_to_get_empty_success",
        "ManagedCodexShellInventoryTests.test_duplicate_requests_writes_and_request_id_reuse_are_terminal",
        "ManagedCodexShellInventoryTests.test_numeric_request_ids_do_not_alias_strings",
        "ManagedCodexShellInventoryTests.test_page_limit_cannot_return_more_entries_than_requested",
        "ManagedCodexShellInventoryTests.test_paginated_empty_responses_are_bounded_not_an_unending_positive_probe",
        "ManagedCodexShellInventoryTests.test_a_completed_inventory_cannot_be_reopened_or_reused_for_new_work",
        "ManagedCodexShellInventoryTests.test_native_enum_construction_cannot_bypass_bounded_request_identity",
        "ManagedCodexShellInventoryTests.test_exact_page_and_terminal_count_limits_are_accepted_before_overflow_is_held",
        "ManagedCodexShellInventoryTests.test_exact_retained_byte_limit_is_accepted_and_the_next_record_is_held"
